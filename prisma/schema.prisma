generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model companies {
  id                                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                               String
  type                               String
  industry                           String?
  free_shipping_threshold            Decimal          @default(10000) @db.Decimal
  shipping_fee                       Decimal          @default(450) @db.Decimal
  created_at                         DateTime         @default(now()) @db.Timestamptz(6)
  orders_orders_buyer_idTocompanies  orders[]         @relation("orders_buyer_idTocompanies")
  orders_orders_seller_idTocompanies orders[]         @relation("orders_seller_idTocompanies")
  products                           products[]
  quote_requests                     quote_requests[]
  users                              users[]
  notifications                      notifications[]
  reviews                            reviews[]
  auctions                           auctions[]
  bids                               bids[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model order_items {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_id   String   @db.Uuid
  product_id String   @db.Uuid
  quantity   Int
  unit_price Decimal  @db.Decimal
  orders     orders   @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  products   products @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model orders {
  id                                    String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  buyer_id                              String        @db.Uuid
  seller_id                             String        @db.Uuid
  status                                String        @default("pending")
  total                                 Decimal       @default(0) @db.Decimal
  needs_approval                        Boolean       @default(false)
  approved_by                           String?       @db.Uuid
  created_by                            String        @db.Uuid
  created_at                            DateTime      @default(now()) @db.Timestamptz(6)
  order_items                           order_items[]
  users_orders_approved_byTousers       users?        @relation("orders_approved_byTousers", fields: [approved_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  companies_orders_buyer_idTocompanies  companies     @relation("orders_buyer_idTocompanies", fields: [buyer_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users_orders_created_byTousers        users         @relation("orders_created_byTousers", fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  companies_orders_seller_idTocompanies companies     @relation("orders_seller_idTocompanies", fields: [seller_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  reviews                               reviews[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model products {
  id                    String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  seller_id             String                  @db.Uuid
  name                  String
  description           String                  @default("")
  category              String
  min_order_qty         Int                     @default(1)
  price_tiers           Json                    @default("[]")
  image_url             String?
  images                String[]                @default([])
  status                String                  @default("draft")
  stock_quantity        Int                     @default(0)
  weight                Float?
  lead_time_days        Int?
  created_at            DateTime                @default(now()) @db.Timestamptz(6)
  order_items           order_items[]
  companies             companies               @relation(fields: [seller_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  quote_requests        quote_requests[]
  reviews               reviews[]
  product_price_history product_price_history[]
  auctions              auctions[]
}

/// Bir ürünün başlangıç (en düşük tier) fiyatı her değiştiğinde alınan anlık görüntü.
model product_price_history {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  product_id  String   @db.Uuid
  price       Decimal  @db.Decimal
  recorded_at DateTime @default(now()) @db.Timestamptz(6)
  products    products @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

/// Alıcının teslim edilmiş bir siparişteki bir ürünü 1-5 arası puanlamasını tutar.
model reviews {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_id   String    @db.Uuid
  product_id String    @db.Uuid
  buyer_id   String    @db.Uuid
  rating     Int
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  orders     orders    @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  products   products  @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  companies  companies @relation(fields: [buyer_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([order_id, product_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model quote_requests {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  buyer_id              String    @db.Uuid
  product_id            String    @db.Uuid
  quantity              Int
  buyer_note            String?
  status                String    @default("pending")
  seller_response_price Decimal?  @db.Decimal
  seller_message        String?
  lead_time             String?
  valid_until           DateTime? @db.Date
  volume_discount       Boolean   @default(false)
  attachment_urls       Json      @default("[]")
  created_at            DateTime  @default(now()) @db.Timestamptz(6)
  companies             companies @relation(fields: [buyer_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  products              products  @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

/// Satıcının bir ürünü açık artırmaya çıkardığı ilan. current_price/current_bidder_id
/// teklif yarışının atomik hedefi olarak denormalize edilmiştir — bids tablosu salt-okunur
/// bir denetim (audit) kaydıdır, yarış kontrolü bunun üzerinden yapılmaz.
model auctions {
  id                String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  product_id        String     @db.Uuid
  starting_price    Decimal    @db.Decimal
  current_price     Decimal    @db.Decimal
  current_bidder_id String?    @db.Uuid
  bid_count         Int        @default(0)
  status            String     @default("active")
  ends_at           DateTime   @db.Timestamptz(6)
  created_at        DateTime   @default(now()) @db.Timestamptz(6)
  products          products   @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  companies         companies? @relation(fields: [current_bidder_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  bids              bids[]
}

/// Bir ihaledeki her teklifin denetim kaydı. Güncel fiyat auctions.current_price'ta tutulur —
/// buradan MAX() ile türetilmez (atomik güncelleme hedefi tek bir sütun olmalı).
model bids {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  auction_id String    @db.Uuid
  bidder_id  String    @db.Uuid
  amount     Decimal   @db.Decimal
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  auctions   auctions  @relation(fields: [auction_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  companies  companies @relation(fields: [bidder_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model notifications {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  company_id  String    @db.Uuid
  category    String    @default("system")
  type        String
  data        Json      @default("{}")
  action_href String?
  read        Boolean   @default(false)
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  companies   companies @relation(fields: [company_id], references: [id], onDelete: Cascade)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model users {
  id                               String    @id @db.Uuid
  company_id                       String    @db.Uuid
  email                            String
  role                             String    @default("staff")
  name                             String
  phone                            String?
  password_hash                    String?
  orders_orders_approved_byTousers orders[]  @relation("orders_approved_byTousers")
  orders_orders_created_byTousers  orders[]  @relation("orders_created_byTousers")
  companies                        companies @relation(fields: [company_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}
